# Корень рабочего каталога varan на хосте: реестр устройств и настройки
# лежат в $VARAN_ROOT/settings и переживают пересборку контейнеров.
# На новых устройствах может быть /var/lib/varan, /opt/varan и т.п.
VARAN_ROOT=/home/orangepi/varan

# Полная авторизация фронта (true/false)
FULL_AUTH=false

# Flask Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# FastAPI Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FLASK_BASE_URL=http://flask-server:5000
DEBUG=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_BROADCAST_INTERVAL=1.0

# Loaders
MAX_LOADERS=3

# CORS (для фронтенда)
CORS_ORIGINS=["http://localhost:3000", "http://localhost"]