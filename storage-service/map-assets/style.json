{
  "version": 8,
  "name": "RJD Journal Dispatch",
  "glyphs": "/api/journal/map/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "/api/journal/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
